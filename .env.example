# Local development. Production should inject PID_API_KEY at runtime.
NODE_ENV=development
PORT=3001
TZ=Europe/Prague

# PID API Key (required for real-time data)
# Get your API key from: https://api.golemio.cz/
PID_API_KEY=your_api_key_here

# Optional public key for CARTO's dark map; blank uses OpenStreetMap without a key.
# Restrict allowed domains in the CARTO dashboard.
# Get a key from https://www.carto.com/basemaps/apikey/
# Never put PID_API_KEY or other private credentials in a VITE_ variable.
VITE_CARTO_API_KEY=
