{
  "name": "busgo-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "check:public-config": "node scripts/check-public-config.mjs",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/server.js",
    "client": "cd busgo && npm run client",
    "postinstall": "npm i --prefix busgo && npm i --prefix server",
    "install-all": "npm i && npm run postinstall",
    "stop-all": "npx -y kill-port 3001 5173"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "jimp": "^1.6.0",
    "sharp": "^0.34.5"
  }
}
