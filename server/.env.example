# Backend server .env
# Create a .env file in the root of your server directory and add your Golemio API key.
GOLEMIO_API_KEY="YOUR_API_KEY_HERE"

# Frontend .env
# For development, you can create a .env file in the root of your React app (client-side)
# to specify the server URL if it's not running on the default localhost:3001
# REACT_APP_SERVER_URL="http://localhost:3001"
